# ─────────────────────────────────────────────────────────────────────────────
# ArchitectOS — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Choose a provider/model and fill in only its API key below (or use Ollama locally)
# 3. Run:            docker-compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# Active provider and model: 'gemini', 'ollama', 'openai', 'deepseek', or 'anthropic'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash

# ── Cloud Provider API Keys (Fill the one you use) ───────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ── Local Model / Ollama Configuration (100% Free & Local) ───────────────────
# To run with a local model like Qwen or Llama via Ollama:
#   1. Start Ollama:  ollama serve
#   2. Pull model:    ollama pull qwen2.5-coder:7b
#   3. Set:
#      LLM_PROVIDER=ollama
#      LLM_MODEL=qwen2.5-coder:7b
# OLLAMA_API_KEY is optional (defaults to 'ollama')
OLLAMA_API_KEY=ollama
