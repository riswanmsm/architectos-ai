# ─────────────────────────────────────────────────────────────────────────────
# ArchitectOS — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Choose a provider/model and fill in only its API key below
# 3. Run:            docker-compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# Active provider and model. Models from an existing provider require no code change.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash

# Provider keys. Keep unused values blank and never commit the real .env file.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
